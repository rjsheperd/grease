# export JAVA_HOME=$PWD/graal/Contents/Home
export JAVA_HOME=$HOME/.graal/latest/Contents/Home
export GRAALVM_HOME=$JAVA_HOME
export PATH=$JAVA_HOME/bin:$PATH

# Sibling ios-graal-jdk-21 repo — source of libjava.a / libjvm.a / libios_jdk_stubs.a.
# build-bb-o syncs newer libs from here into lib/ios-arm64/ automatically.
export IOS_GRAAL_HOME="$(cd "$(dirname "$BASH_SOURCE")/../ios-graal-jdk-21" 2>/dev/null && pwd || echo "")"

# Local lib dir — synced from ios-graal-jdk-21 by build-bb-o; referenced by
# xcconfig and build-demo-app so the grease repo is self-contained at link time.
export IOS_GRAAL_LIBS="$PWD/lib/ios-arm64"

# iOS cross-compilation environment
export CC=$(xcrun --sdk iphoneos --find clang 2>/dev/null || echo "")
export CXX=$(xcrun --sdk iphoneos --find clang++ 2>/dev/null || echo "")
export SDKROOT=$(xcrun --sdk iphoneos --show-sdk-path 2>/dev/null || echo "")
export SYSROOT=$SDKROOT
export ARCHFLAGS="-arch arm64 -miphoneos-version-min=16.0"
export CFLAGS="-target arm64-apple-ios16.0 $ARCHFLAGS --sysroot=$SDKROOT"
export LDFLAGS="-target arm64-apple-ios16.0 $ARCHFLAGS --sysroot=$SDKROOT"

# Xcode 14.3.1 — must match xcode-select active path
export XCODE_DEVELOPER_DIR="/Volumes/MegaDisk2TB/XCode/AF56C562-4191-470B-AECA-8CBE68A2E188/Xcode.app/Contents/Developer"

# Apple Developer team and device
export DEVELOPMENT_TEAM="SGU7Q3E572"
export DEVICE_UDID="00008020-001375322603002E"

# Code signing — SHA-1 of "Apple Development" cert (login keychain)
export CERT_HASH="4B676A3846AA8E49E03605A35FCE986A031735AB"

# Provisioning profile UUID (~/.../Provisioning\ Profiles/$PROFILE_UUID.mobileprovision)
export PROFILE_UUID="b4f06a6d-0943-4bea-bc89-896f17e9a1fa"

# App Store Connect API key (used by fastlane)
export APPLE_ISSUER_ID="69a6de72-7558-47e3-e053-5b8c7c11a4d1"
export APPLE_KEY_ID="2A5S6Y9B9Q"
export APPLE_SECRET_PATH=$HOME/.apple_dev/AuthKey_2A5S6Y9B9Q.p8
