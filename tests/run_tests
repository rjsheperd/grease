#!/usr/bin/env bash
# tests/run_tests — run all Clojure integration tests against the device nREPL.
#
# Thin wrapper around tests/run_all_tests.clj — all logic lives there.
#
# Prerequisites:
#   - App deployed and running (scripts/debug-demo-app --noinstall)
#   - nREPL listening at NREPL_HOST:NREPL_PORT (default 192.168.0.111:23456)
#
# Usage:
#   tests/run_tests                          # all suites except location
#   tests/run_tests --all                    # all suites including location
#   tests/run_tests foundation hiccup nav    # specific suites only
#
# Available suite names:
#   foundation  repl  bluetooth  blocks  uikit  engine  frameworks
#   hiccup  hiccup-diffing  nav  location

exec clj -Sdeps '{"deps" {"nrepl/nrepl" {"mvn/version" "1.3.0"}}}' \
         -M tests/run_all_tests.clj "$@"
