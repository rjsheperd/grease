;; CoreLocation framework spec — hand-written oracle.
;;
;; Reference implementation: dev/test_location.clj
;; Classes covered: CLLocationManager, CLLocation
;; Protocols: CLLocationManagerDelegate
;;
;; CLLocationManager and its delegate wiring must run on the main thread.
;; CLLocation is immutable; created by the system and received in delegate callbacks.

{:framework "CoreLocation"
 :doc-url   "https://developer.apple.com/documentation/corelocation"

 :classes
 [{:name        "CLLocationManager"
   :superclass  "NSObject"
   :main-thread? true
   :init
   [{:selector "new"
     :encoding "@@:"
     :args     []
     :return   "CLLocationManager"}
    {:selector "init"
     :encoding "@@:"
     :args     []
     :return   "id"}]
   :methods
   [{:selector "startUpdatingLocation"
     :encoding "v@:"
     :args     []
     :return   "void"
     :main-thread? true}
    {:selector "stopUpdatingLocation"
     :encoding "v@:"
     :args     []
     :return   "void"
     :main-thread? true}
    {:selector "requestWhenInUseAuthorization"
     :encoding "v@:"
     :args     []
     :return   "void"
     :main-thread? true}
    {:selector "requestAlwaysAuthorization"
     :encoding "v@:"
     :args     []
     :return   "void"
     :main-thread? true}
    {:selector "setDelegate:"
     :encoding "v@:@"
     :args     [{:name     "delegate"
                 :type     "id"
                 :pattern  :delegate
                 :protocol "CLLocationManagerDelegate"
                 :nullable true}]
     :return   "void"
     :main-thread? true}]
   :properties []}

  {:name       "CLLocation"
   :superclass "NSObject"
   :init       []
   :methods
   [{:selector "horizontalAccuracy"
     :encoding "d@:"
     :args     []
     :return   "Double"}
    {:selector "altitude"
     :encoding "d@:"
     :args     []
     :return   "Double"}
    {:selector "speed"
     :encoding "d@:"
     :args     []
     :return   "Double"}
    {:selector "timestamp"
     :encoding "@@:"
     :args     []
     :return   "id"
     :doc      "Returns NSDate pointer — use NSDate methods to extract time"}
    ;; coordinate returns CLLocationCoordinate2D (16 bytes, 2 doubles).
    ;; On arm64 this is a HFA (Homogeneous Floating-point Aggregate) returned
    ;; in d0/d1.  invoke/dispatch! uses ffi/call-ptr with a dt-struct type
    ;; so libffi handles the HFA calling convention correctly.
    {:selector "coordinate"
     :encoding "{CLLocationCoordinate2D=dd}@:"
     :args     []
     :return   "CLLocationCoordinate2D"
     :doc      "Returns CLLocationCoordinate2D {:latitude double :longitude double}"}]
   :properties []}]

 :protocols
 [{:name    "CLLocationManagerDelegate"
   :methods
   [{:selector "locationManager:didUpdateLocations:"
     :encoding "v@:@@"
     :args     [{:name "manager"   :type "id"}
                {:name "locations" :type "id"}]}
    {:selector "locationManager:didFailWithError:"
     :encoding "v@:@@"
     :args     [{:name "manager" :type "id"}
                {:name "error"   :type "id"}]}
    {:selector "locationManagerDidChangeAuthorization:"
     :encoding "v@:@"
     :args     [{:name "manager" :type "id"}]}]}]

 :enums     []
 :constants []}
