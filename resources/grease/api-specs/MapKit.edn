;; MapKit framework spec — hand-written ObjC oracle.
;;
;; The auto-scraped version pulled Swift documentation and is not usable.
;; This spec covers the ObjC subset needed for the map+tab-bar demo app.
;;
;; MKCoordinateRegion is a 32-byte C struct (two 16-byte HFA sub-structs).
;; setRegion:animated: passes it by value in ARM64 floating-point registers.
;; grease.ios.invoke/dispatch! handles this via ffi/call-ptr + composite
;; ffi_type — no C shim required.
;;
;; All MKMapView operations must run on the main thread.

{:framework "MapKit"
 :doc-url   "https://developer.apple.com/documentation/mapkit"

 :classes
 [{:name       "MKMapView"
   :superclass "UIView"
   :init
   [{:selector "new"
     :encoding "@@:"
     :return   "id"
     :args     []
     :doc      "Creates an MKMapView with a zero frame; resize with set-frame! after addSubview:"}]
   :methods
   [{:selector     "showsUserLocation"
     :encoding     "B@:"
     :return       "BOOL"
     :args         []
     :main-thread? true
     :doc          "Returns YES if the blue user-location dot is enabled"}
    {:selector     "setShowsUserLocation:"
     :encoding     "v@:B"
     :return       "void"
     :args         [{:name "showsUserLocation" :type "BOOL"}]
     :main-thread? true
     :doc          "Shows or hides the blue user-location dot"}
    {:selector     "userTrackingMode"
     :encoding     "q@:"
     :return       "NSInteger"
     :args         []
     :main-thread? true
     :doc          "Current MKUserTrackingMode (0=none 1=follow 2=followWithHeading)"}
    {:selector     "setUserTrackingMode:animated:"
     :encoding     "v@:qB"
     :return       "void"
     :args         [{:name "mode"     :type "NSInteger"}
                    {:name "animated" :type "BOOL"}]
     :main-thread? true
     :doc          "Sets the user tracking mode. Use MKUserTrackingModeFollow (1) to auto-center on user."}
    {:selector     "mapType"
     :encoding     "q@:"
     :return       "NSInteger"
     :args         []
     :main-thread? true
     :doc          "Current MKMapType (0=standard 1=satellite 2=hybrid)"}
    {:selector     "setMapType:"
     :encoding     "v@:q"
     :return       "void"
     :args         [{:name "mapType" :type "NSInteger"}]
     :main-thread? true}
    {:selector     "setRegion:animated:"
     :encoding     "v@:{MKCoordinateRegion={CLLocationCoordinate2D=dd}{MKCoordinateSpan=dd}}B"
     :return       "void"
     :args         [{:name "region"   :type "MKCoordinateRegion"}
                    {:name "animated" :type "BOOL"}]
     :main-thread? true
     :doc          "Centers the map on region (MKCoordinateRegion struct by value). Dispatched via libffi composite ffi_type — no C shim needed."}]
   :properties []}

  {:name       "MKUserLocation"
   :superclass "NSObject"
   :init       []
   :methods
   [{:selector "location"
     :encoding "@@:"
     :return   "id"
     :args     []
     :doc      "Returns the CLLocation object representing the user's current location"}
    {:selector "isUpdating"
     :encoding "B@:"
     :return   "BOOL"
     :args     []}]
   :properties []}]

 :protocols
 [{:name    "MKMapViewDelegate"
   :methods [{:selector "mapView:didUpdateUserLocation:"
              :encoding "v@:@@"}
             {:selector "mapView:didFailToLocateUserWithError:"
              :encoding "v@:@@"}]}]

 :enums
 [{:name   "MKUserTrackingMode"
   :values [{:name "none"              :raw 0}
            {:name "follow"            :raw 1}
            {:name "followWithHeading" :raw 2}]}
  {:name   "MKMapType"
   :values [{:name "standard"          :raw 0}
            {:name "satellite"         :raw 1}
            {:name "hybrid"            :raw 2}
            {:name "satelliteFlyover"  :raw 3}
            {:name "hybridFlyover"     :raw 4}
            {:name "mutedStandard"     :raw 5}]}]

 :constants []}
