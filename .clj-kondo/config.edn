{;; Teach kondo that defclass / defclass! define a var (first arg is the name).
 ;; Without this, any reference to a defclass'd symbol is reported as unresolved.
 :lint-as {grease.ios.objc/defclass        clojure.core/def
           grease.ios.repl/defclass!       clojure.core/def
           ;; with-retained uses let-style bindings as its first arg
           grease.ios.foundation/with-retained  clojure.core/let
           ;; let-completion uses let-style bindings (first or second arg)
           grease.ios.completion/let-completion clojure.core/let
           ;; defscreen defines a var named after its first arg
           grease.ios.screen/defscreen          clojure.core/def}}
